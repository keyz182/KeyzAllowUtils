<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFrameworks>net9.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <RootNamespace>KeyzAllowUtilities.Tests</RootNamespace>
        <AssemblyName>KeyzAllowUtilities.Tests</AssemblyName>
        <OutputType>Exe</OutputType>
        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>
    <!-- Game DLL references — copy to output so the .NET 9 runtime can load them -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0' and '$(RimWorldManagedDir)' != ''">
        <Reference Include="Assembly-CSharp">
            <HintPath>$(RimWorldManagedDir)/Assembly-CSharp.dll</HintPath>
            <Private>True</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(RimWorldManagedDir)/UnityEngine.CoreModule.dll</HintPath>
            <Private>True</Private>
        </Reference>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="JetBrains.Annotations" Version="2025.2.2" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.13.0" />
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.1" />
        <PackageReference Include="xunit.v3" Version="3.2.0" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../KeyzAllowUtilities/KeyzAllowUtilities.csproj" />
    </ItemGroup>
    <Target Name="RunTestsAfterBuild" AfterTargets="Build" Condition="'$(TargetFramework)' == 'net9.0'">
        <Exec Command="dotnet test --no-build --framework net9.0 --logger console;verbosity=minimal"
              WorkingDirectory="$(MSBuildProjectDirectory)" />
    </Target>
</Project>
