<?xml version="1.0" encoding="utf-8"?>

<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <OutputType>Library</OutputType>
        <LangVersion>latest</LangVersion>
        <RootNamespace>KeyzAllowUtilities.PUAH</RootNamespace>
        <AssemblyName>KeyzAllowUtilities.PUAH</AssemblyName>
        <OutputPath>../../../Compatibility/mehni.pickupandhaul/1.6/Assemblies</OutputPath>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <Optimize>false</Optimize>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>portable</DebugType>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
        <DebugType>embedded</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <Optimize>true</Optimize>
    </PropertyGroup>
    <!-- Game DLL references — path resolved by Directory.Build.props/targets -->
    <ItemGroup Condition="'$(RimWorldManagedDir)' != ''">
        <Reference Include="Assembly-CSharp">
            <HintPath>$(RimWorldManagedDir)/Assembly-CSharp.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.CoreModule">
            <HintPath>$(RimWorldManagedDir)/UnityEngine.CoreModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.IMGUIModule">
            <HintPath>$(RimWorldManagedDir)/UnityEngine.IMGUIModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="UnityEngine.TextRenderingModule">
            <HintPath>$(RimWorldManagedDir)/UnityEngine.TextRenderingModule.dll</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>
    <!-- Workshop mod reference -->
    <ItemGroup Condition="'$(SteamWorkshopDir)' != ''">
        <Reference Include="PickUpAndHaul">
            <HintPath>$(SteamWorkshopDir)/1279012058/1.6/Assemblies/PickUpAndHaul.dll</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Lib.Harmony" Version="2.*" ExcludeAssets="runtime" />
    </ItemGroup>

    <!-- CI fallback: when game DLLs aren't available, use stub reference assemblies -->
    <ItemGroup Condition="'$(RimWorldManagedDir)' == ''">
        <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.*" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\KeyzAllowUtilities\KeyzAllowUtilities.csproj">
            <Private>false</Private>
        </ProjectReference>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="..\..\..\Compatibility\mehni.pickupandhaul.unoffical\1.6\Assemblies\">
        <Link>ModCompatFiles\Assemblies</Link>
      </Folder>
    </ItemGroup>

    <PropertyGroup>
        <StartAction>Program</StartAction>
        <StartProgram>$(SolutionDir)../../../../RimWorldWin64.exe</StartProgram>
    </PropertyGroup>
</Project>
