<?xml version="1.0" encoding="UTF-8" ?>
<Patch>
    <Operation Class="PatchOperationSequence">
        <operations>
            <li Class="PatchOperationInsert">
                <order>Append</order>
                <xpath>/Defs/DesignationCategoryDef[defName="Floors"]/specialDesignatorClasses/li[6]</xpath>
                <value>
                    <li>KeyzAllowUtilities.Designator_Floors</li>
                </value>
            </li>
            <!-- Grabbed from original Allow Tool - puts the tool in the place people expect -->
            <li Class="PatchOperationInsert">
                <order>Append</order>
                <xpath>/Defs/DesignationCategoryDef[defName="Orders"]/specialDesignatorClasses/li[13]</xpath>
                <value>
                    <li>KeyzAllowUtilities.Designator_HaulUrgently</li>
                    <li>KeyzAllowUtilities.Designator_SelectSimilar</li>
                    <li>KeyzAllowUtilities.Designator_FinishOff</li>
                    <li>KeyzAllowUtilities.Designator_StripMine</li>
                    <li>KeyzAllowUtilities.Designator_CutGrown</li>
                    <li>KeyzAllowUtilities.Designator_CutBlighted</li>
                    <li>KeyzAllowUtilities.Designator_HarvestGrown</li>
                    <li>KeyzAllowUtilities.Designator_HarvestGrownWood</li>
                    <li>KeyzAllowUtilities.Designator_HarvestAll</li>
                    <li>KeyzAllowUtilities.Designator_HarvestAllWood</li>
                </value>
            </li>
            <!-- Grabbed from original Allow Tool - puts the tool in the place people expect -->
            <li Class="PatchOperationInsert">
                <order>Append</order>
                <xpath>/Defs/DesignationCategoryDef[defName="Zone"]/specialDesignatorClasses/li[5]</xpath>
                <value>
                    <li>KeyzAllowUtilities.Designator_ZoneAdd_GrowingFertile</li>
                </value>
            </li>
            <!-- ~1~ Remove stock forbid designator @1@ -->
            <!-- <li Class="PatchOperationRemove"> -->
            <!--     <success>Always</success> -->
            <!--     <xpath>/Defs/DesignationCategoryDef[defName="Orders"]/specialDesignatorClasses/li[text()="Designator_Forbid"]</xpath> -->
            <!-- </li> -->
            <!-- ~1~ Remove stock unforbid designator @1@ -->
            <!-- <li Class="PatchOperationRemove"> -->
            <!--     <success>Always</success> -->
            <!--     <xpath>/Defs/DesignationCategoryDef[defName="Orders"]/specialDesignatorClasses/li[text()="Designator_Unforbid"]</xpath> -->
            <!-- </li> -->
        </operations>
    </Operation>
    <!-- Gate vanilla Designator_Open: skip when Ancient urban ruins (packageId: XMB.AncientUrbanrUins.MO) is loaded — AUR ships its own Open designator and colliding causes a duplicate entry. -->
    <Operation Class="PatchOperationFindMod">
        <mods>
            <li>Ancient urban ruins</li>
        </mods>
        <nomatch Class="PatchOperationAdd">
            <xpath>/Defs/DesignationCategoryDef[defName="Orders"]/specialDesignatorClasses</xpath>
            <value>
                <li>RimWorld.Designator_Open</li>
            </value>
        </nomatch>
    </Operation>
</Patch>
